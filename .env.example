# STEW Log local-development environment example
#
# Django does not load this file itself. Configure VS Code's Python envFile,
# a launch profile, or the terminal process to load a copied, ignored `.env`.
# Never use these placeholders as production credentials.

DEBUG=true
SECRET_KEY=replace-with-a-unique-local-development-value
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local SQLite is used when DATABASE_URL is unset.
# DATABASE_URL=replace-with-a-local-postgresql-url

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_VERIFICATION_PUBLIC_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_RESEND_COOLDOWN_MINUTES=60
EMAIL_VERIFICATION_PENDING_STALE_MINUTES=15

PAY_PLAN_ASSISTANT_PROVIDER_ENABLED=false
PAY_PLAN_ASSISTANT_PROVIDER=openai
PAY_PLAN_ASSISTANT_MODEL=gpt-5.6-sol
PAY_PLAN_ASSISTANT_TIMEOUT_SECONDS=10
PAY_PLAN_ASSISTANT_ROLLOUT_PERCENT=0
PAY_PLAN_ASSISTANT_ALLOWED_USER_IDS=
PAY_PLAN_ASSISTANT_DAILY_REQUEST_LIMIT=20
PAY_PLAN_ASSISTANT_MAX_PROVIDER_INPUT_CHARS=8000
PAY_PLAN_ASSISTANT_MAX_PROVIDER_RESPONSE_BYTES=65536
PAY_PLAN_ASSISTANT_MAX_OUTPUT_TOKENS=600
PAY_PLAN_ASSISTANT_MAX_TURNS=12
PAY_PLAN_ASSISTANT_CONVERSATION_TTL_HOURS=24
PAY_PLAN_ASSISTANT_EVENT_RETENTION_DAYS=30
# CX-3 read-only Ask Stew AI pilot. Add comma-separated immutable Django user
# IDs to enable specific pilot users; remove an ID to disable that user.
ASK_STEW_AI_PILOT_USER_IDS=
# OPENAI_API_KEY=replace-with-a-local-development-key

# Phase 2A Teams remains off until its rollout checklist is approved. The
# optional user-ID allowlist is a DEBUG-only development fallback. Production
# Teams entitlement is owned by the billing entitlement service.
TEAMS_FEATURE_ENABLED=false
TEAMS_FOUNDER_USER_IDS=
TEAMS_INVITATION_TTL_HOURS=168
# Seconds; must not exceed the configured invitation lifetime.
TEAM_INVITATION_VERIFICATION_RESUME_MAX_AGE=604800

# Resend production SMTP (configure in Render, not in a committed file):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=replace-with-the-resend-api-key
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=STEW Log <no-reply@mail.stewlog.com>
# EMAIL_VERIFICATION_PUBLIC_BASE_URL=https://stewlog.com

# Stripe/dj-stripe subscription foundation. Keep both flags false until the
# selected mode is fully configured, migrated, and webhook-tested. Stripe test
# and live objects are separate; never copy test identifiers into live settings.
STRIPE_LIVE_MODE=false
STRIPE_TEST_PUBLIC_KEY=pk_test_REPLACE_WITH_PRIVATE_VALUE
STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_WITH_PRIVATE_VALUE
STRIPE_LIVE_PUBLIC_KEY=pk_live_REPLACE_WITH_PRIVATE_VALUE
STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE_WITH_PRIVATE_VALUE
# When tiered pricing is off, the existing single Price remains configured in
# STRIPE_BASIC_MONTHLY_PRICE_ID and retains its current Pro behavior.
STRIPE_BASIC_MONTHLY_PRICE_ID=price_REPLACE_WITH_SELECTED_MODE_VALUE
STRIPE_PRO_MONTHLY_PRICE_ID=
# Before enabling BILLING_TIERED_PRICING_ENABLED, move the former single Price
# ID into this comma-separated grandfathered-Pro allowlist.
STRIPE_LEGACY_PRO_PRICE_IDS=
BILLING_FEATURE_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
# CXP-2B: gate only accounts created while this flag is enabled through
# verified email, Stripe Checkout, and then My Pay Plan setup.
BILLING_ONBOARDING_ENABLED=false
# BILL-2: requires synchronized $3.99 Basic and $7.99 Pro monthly Prices plus
# every uninterrupted legacy Pro Price in STRIPE_LEGACY_PRO_PRICE_IDS.
BILLING_TIERED_PRICING_ENABLED=false
BILLING_STANDARD_TRIAL_DAYS=30
BILLING_FOUNDER_TRIAL_DAYS=90

# The signing secret belongs to the mode-specific dj-stripe WebhookEndpoint
# database row and is not an environment variable in this application.

# Google and Apple django-allauth SocialApp credentials are database-backed in
# this repository; there are no Google/Apple environment variables to set here.
